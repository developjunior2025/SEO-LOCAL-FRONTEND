{
  "name": "seo-local-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-orchestrator.mjs",
    "dev:all": "node scripts/dev-orchestrator.mjs",
    "dev:frontend": "vite --open",
    "dev:backend": "npm --prefix ../../SEO-LOCAL-BACKEND-main run start:dev",
    "dev:database": "node scripts/start-database.mjs",
    "dev:wait-db": "wait-on tcp:127.0.0.1:5434 --timeout 120000",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ignore-pattern \"backend-patches/**\" --ignore-pattern \"dist/**\" --ignore-pattern \"coverage/**\"",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "images:sync": "node scripts/sync-marketplace-images.mjs",
    "lint:source": "eslint src scripts vite.config.ts --ignore-pattern \"backend-patches/**\" --ignore-pattern \"dist/**\" --ignore-pattern \"coverage/**\"",
    "test:source": "vitest run --config vitest.config.ts src"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.2",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "motion": "^12.23.24",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}

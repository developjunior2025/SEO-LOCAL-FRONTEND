# URL base de la API (obligatoria en producción; en desarrollo fallback a localhost:4001)
VITE_API_URL=http://localhost:4001/api/v1

# Activar login demo únicamente en desarrollo (valores: true | false)
VITE_ENABLE_DEMO_AUTH=false

# Activar datos demo únicamente en desarrollo (valores: true | false)
VITE_ENABLE_DEMO_DATA=false

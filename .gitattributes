# Normalización general de archivos de texto
* text=auto eol=lf

# Código fuente y configuración
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.sql text eol=lf
*.env text eol=lf
*.example text eol=lf
*.sh text eol=lf

# Archivos propios de Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

